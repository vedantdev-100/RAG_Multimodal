# --- App ---
APP_NAME=ai-platform
ENVIRONMENT=development        # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_platform

# --- Redis (refresh-token store / rate limiting / token blacklist) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (RS256) ---
# Generate with:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
JWT_PRIVATE_KEY_PATH=./secrets/private_key.pem
JWT_PUBLIC_KEY_PATH=./secrets/public_key.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_LOGOUT=10/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=5/minute

# --- DB connection pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- RAG / retrieval ---
RAG_DEFAULT_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_DISTANCE_METRIC=cosine
RAG_HYBRID_VECTOR_WEIGHT=0.5

# --- Ingestion: storage & upload limits ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
RAG_MAX_UPLOAD_MB=25

# --- Model storage ---
# Populated by: uv run python -m app.cli.download_models
# Loaded from here only — never downloaded lazily at request time.
MODELS_DIR=./models

# --- Parsing (Docling) ---
RAG_PARSER_BACKEND=docling
RAG_PARSER_MAX_CONCURRENCY=1
RAG_DOCLING_LOCAL_MODELS_ONLY=true
RAG_OCR_ENABLED=true
RAG_TABLE_STRUCTURE_ENABLED=true

# --- Picture / chart description (off by default) ---
# Turns pictures/charts into searchable text via a vision-language model.
RAG_PICTURE_DESCRIPTION_ENABLED=false
RAG_PICTURE_DESCRIPTION_BACKEND=local        # "local" | "api"
RAG_PICTURE_DESCRIPTION_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
RAG_PICTURE_DESCRIPTION_PROMPT=Describe this image in a few sentences. If it is a chart, graph or diagram, state its type, axes, series, and the key values and trends.
RAG_PICTURE_MIN_AREA=0.05
# Only used when RAG_PICTURE_DESCRIPTION_BACKEND=api. SECURITY: this sends
# document images to an external endpoint — only point it at one you trust.
RAG_PICTURE_DESCRIPTION_API_URL=
RAG_PICTURE_DESCRIPTION_API_MODEL=
RAG_PICTURE_DESCRIPTION_API_KEY=
RAG_PICTURE_DESCRIPTION_TIMEOUT=60

# --- Chunking ---
RAG_CHUNKER_BACKEND=docling                  # "docling" (HybridChunker) | "simple" (fixed-size, offline)
RAG_CHUNKER_TOKENIZER=huggingface            # "huggingface" (real, needs the model below) | "approx" (offline)
RAG_CHUNKER_TOKENIZER_MODEL=BAAI/bge-base-en-v1.5   # keep equal to RAG_EMBEDDING_MODEL
RAG_CHUNKER_MAX_TOKENS=500
RAG_CHUNKER_MERGE_PEERS=true

# --- Embeddings ---
RAG_EMBEDDING_BACKEND=sentence_transformers  # "stub" (testing only) | "sentence_transformers" (real)
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_DEVICE=                        # blank = auto (cuda if available), or "cpu"/"cuda"
RAG_EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=768                     # must match the model above; pgvector column width
